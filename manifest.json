{
  "manifest_version": 3,
  "name": "AP-Solver: 3-Section Fullstack & API Challenge AI Copilot",
  "version": "1.0.0",
  "description": "Autonomous AI Solver for 3-Panel web coding platforms (Question + VS Code Web + HTTP Request). Reads questions, extracts active editor code, generates optimal solutions using Gemini/Groq/OpenAI, injects code into Monaco/VS Code, and auto-verifies submissions.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "clipboardWrite",
    "clipboardRead",
    "debugger"
  ],
  "host_permissions": [
    "https://*.newtonschool.co/*",
    "https://my.newtonschool.co/*",
    "https://*.edison.newtonschool.co/*",
    "https://*.edison-jupyter.newtonschool.co/*",
    "https://*.vscode.dev/*",
    "https://*.github.dev/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.cerebras.ai/*",
    "https://integrate.api.nvidia.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.newtonschool.co/*",
        "https://*.newtonschool.co/*"
      ],
      "js": [
        "content/frame-editor.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://my.newtonschool.co/*",
        "https://*.newtonschool.co/*"
      ],
      "js": [
        "content/shared.js",
        "content/dom-scrapers.js",
        "content/error-parser.js",
        "content/solver-ui.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/main-world-bridge.js",
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AP-Solver AI Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
